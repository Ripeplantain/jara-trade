# Copy to .env; docker compose reads it automatically. Every value is optional.

# Host port for the dashboard (default 3000)
PORT=3000

# Massive market data key. Unset: built-in price simulator.
MASSIVE_API_KEY=

# OpenRouter key for the AI assistant. Unset: the panel shows "not configured".
OPENROUTER_API_KEY=
# OpenRouter model slug (default: openai/gpt-oss-120b:free)
ASSISTANT_MODEL=
